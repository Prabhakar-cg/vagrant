Vagrant.require_version ">= 2.4.9"
image      =  "ubuntu/jammy64"
# version    =  "20241002.0.0"
cpus       =  "4"
memory     =  "8000"
gui        =  false
count      =  1

Vagrant.configure("2") do |multi|
  multi.vm.provision "shell", path: "generic.sh"

  (1..count).each do |i|
    private_ip = "192.168.56.7#{i}"
    host_name  =  "ubuntu#{i}.vbox"
    guest_name =  "ubuntu#{i}"

    multi.vm.define "ubuntu_#{i}" do | multi_node |
      multi_node.vm.synced_folder ".", "/vagrant", disabled: true
      multi_node.vm.box         = image
      # multi_node.vm.box_version = version
      multi_node.vm.hostname    = host_name
      multi_node.vm.boot_timeout = 1800
      multi_node.vm.network "private_network", ip: private_ip, hostname: true
      # multi_node.vm.network "public_network", bridge: "Intel(R) Wi-Fi 6 AX201 160MHz"

      multi_node.vm.provider "virtualbox" do | node |
        node.name    = guest_name
        node.gui     = gui
        node.cpus    = cpus
        node.memory  = memory
        # This host runs VirtualBox alongside Hyper-V (required for WSL2), so
        # VirtualBox falls back to NEM emulation instead of native VT-x. Under
        # NEM, more than 1 vCPU + the default paravirt profile causes random
        # mid-boot hangs. This combo is what reliably boots on this machine.
        node.customize ["modifyvm", :id, "--paravirtprovider", "hyperv"]
        node.customize ["modifyvm", :id, "--ioapic", "off"]
        node.customize ["modifyvm", :id, "--uart1", "off"]
      end
    end
  end  
end
